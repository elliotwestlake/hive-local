---
// A Material Design icon (the set Home Assistant uses), inline so there's nothing to load.
interface Props { path: string; class?: string; label?: string }
const { path, class: cls = "icon", label } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}><path d={path} /></svg>
