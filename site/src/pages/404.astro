---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page doesn't exist.">
  <main class="wrap lost">
    <h1>That page isn't here</h1>
    <p class="muted">It may have moved when the docs left the wiki.</p>
    <div class="cta"><a class="btn primary" href="/docs/">Go to the docs</a><a class="btn" href="/">Home</a></div>
  </main>
</Base>
<style>
  .lost { padding-top: 96px; text-align: center; }
  h1 { font-size: 40px; letter-spacing: -0.02em; margin: 0; }
  .cta { display: flex; gap: 10px; justify-content: center; margin-top: 24px; }
</style>
