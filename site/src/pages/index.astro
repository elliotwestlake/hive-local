---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { MARKETPLACE, REPO } from "../lib/nav";
import {
  mdiArrowRight, mdiBagSuitcaseOutline, mdiCalendarClock, mdiCellphone, mdiChartBar, mdiCheck,
  mdiCloudOffOutline, mdiFire, mdiGithub, mdiRadiator, mdiShieldCheckOutline, mdiSignalOff,
  mdiSourceBranch, mdiThermometerChevronUp, mdiZigbee,
} from "@mdi/js";

import hero from "../assets/screenshots/hero.png";
import schedule from "../assets/screenshots/schedule.png";
import rooms from "../assets/screenshots/rooms.png";
import statsCost from "../assets/screenshots/stats-cost.png";
import phones from "../assets/screenshots/phones.png";

const facts = [
  { icon: mdiCloudOffOutline, title: "No Hive cloud or hub", text: "Everything runs over your own Zigbee network." },
  { icon: mdiShieldCheckOutline, title: "Keeps running without HA", text: "Schedules live on the receiver itself." },
  { icon: mdiZigbee, title: "Zigbee2MQTT or ZHA", text: "Use whichever your Home Assistant has." },
  { icon: mdiSourceBranch, title: "Free and open source", text: "No account, no subscription, no tracking." },
];

// The three headline features get a section each; the rest are cards below them.
const features = [
  {
    icon: mdiCalendarClock, kicker: "Schedules",
    title: "Edit the schedule on the receiver itself",
    text: "Read the week from the receiver, change a day, copy it to the weekdays, and save. Because the schedule lives on the receiver, it keeps running even when Home Assistant is down.",
    points: ["Up to six times a day, like the Hive app", "Copy a day to weekdays, the weekend or every day", "Only the days you changed are written"],
    image: schedule, alt: "A day's schedule, with each time's temperature.", href: "/docs/schedules/",
  },
  {
    icon: mdiRadiator, kicker: "Rooms",
    title: "Rooms of Hive radiator valves",
    text: "Group your Hive radiator valves into rooms, set one target for the room, and see each valve's temperature and battery. Hive Local can suggest rooms from your Home Assistant areas.",
    points: ["One target for every valve in a room", "A room sensor, or the valves' own readings", "Low batteries and unresponsive valves flagged"],
    image: rooms, alt: "A room with its temperature, target and radiator valves.", href: "/docs/rooms/",
  },
  {
    icon: mdiChartBar, kicker: "Stats",
    title: "See how long the boiler ran, and what it cost",
    text: "Day, week and month views of boiler time, against the period before and the weather. Link your gas meter and Hive Local learns what your boiler really uses, for an honest cost estimate.",
    points: ["Learns your boiler's real output from the gas meter", "Uses your Energy dashboard's gas price, or your own", "Outside temperature from any weather entity"],
    image: statsCost, alt: "A week of boiler time with its estimated cost.", href: "/docs/stats/",
  },
];

const more = [
  { icon: mdiFire, title: "Boost and modes", text: "Schedule, Manual, Off and boost from the panel, entities or actions, designed to match Hive Local Thermostat.", href: "/docs/entities-and-actions/" },
  { icon: mdiThermometerChevronUp, title: "Pre-heat", text: "Learns how fast your home warms up and starts early, so it's warm when the schedule says.", href: "/docs/pre-heat/" },
  { icon: mdiBagSuitcaseOutline, title: "Away until…", text: "Holds frost protection and turns the hot water off until you're back, and fails safe if Home Assistant stops.", href: "/docs/holiday/" },
  { icon: mdiSignalOff, title: "Fixes “No signal” on ZHA", text: "Keeps Hive thermostats reporting often enough that the receiver doesn't drop them and turn the boiler off.", href: "/docs/troubleshooting/" },
];

const steps = [
  { title: "Install", text: "Add Hive Local from the Marketplace (formerly HACS) and restart Home Assistant." },
  { title: "Add your receiver", text: "Choose Zigbee2MQTT or ZHA, then pick the receiver, not the wall thermostat." },
  { title: "Open Hive", text: "Find Hive in the sidebar, and read your schedule from the receiver." },
];

const hardware = ["SLR1 / SLR1b–d", "OTR1", "SLR2 / SLR2b–d", "Hive radiator valves", "Hive thermostats"];

const faqs = [
  {
    q: "Do I still need the Hive hub or app?",
    a: "No. The receiver is paired to your own Zigbee network (Zigbee2MQTT or ZHA) instead of the Hive hub, and Hive Local controls it from there. The Hive app can't see a receiver that isn't on the Hive hub.",
  },
  {
    q: "What happens if Home Assistant goes down?",
    a: "Your heating carries on. The schedule is stored on the receiver, and the wall thermostat still works. Boosts, pre-heats and holidays all use the receiver's own self-ending boost, so nothing is left on.",
  },
  {
    q: "How is this different from Hive Local Thermostat?",
    a: "Both control Hive receivers locally. Hive Local's boost, cancel and mode entities and actions were designed to match Hive Local Thermostat's, so moving across feels familiar, and it adds the Hive panel, schedules, rooms, stats, pre-heat and holiday mode.",
  },
];
---
<Base title="Hive Local" description="Local control of Hive heating and hot water from Home Assistant, with no Hive cloud and no Hive hub. Schedules, boost, rooms, stats and holiday mode.">
  <main>
    <section class="hero wrap">
      <span class="pill rise" style="--d: 0ms"><Icon path={mdiZigbee} /> For Home Assistant, on Zigbee2MQTT or ZHA</span>
      <h1 class="rise" style="--d: 80ms">Your Hive heating, without the cloud.</h1>
      <p class="lede rise" style="--d: 180ms">Hive Local runs your Hive receiver straight from Home Assistant over Zigbee. Change the schedule, boost the heating and see what the boiler's doing, with no hub, no account and nothing in the cloud.</p>
      <div class="cta rise" style="--d: 260ms">
        <a class="btn primary" href={MARKETPLACE}>Add to Home Assistant <Icon path={mdiArrowRight} /></a>
        <a class="btn" href="/docs/">Read the docs</a>
      </div>
      <div class="hero-shot rise-shot" style="--d: 380ms">
        <Image src={hero} alt="The Hive panel on a desktop and a phone: heating following its schedule, and hot water on a boost." widths={[700, 1400, 2100, 2800]} sizes="(max-width: 1120px) 100vw, 1088px" loading="eager" />
      </div>
    </section>

    <section class="facts wrap" aria-label="At a glance">
      {facts.map((f, i) => (
        <div class="fact reveal" style={`--d: ${i * 70}ms`}>
          <span class="icon-box"><Icon path={f.icon} /></span>
          <div><strong>{f.title}</strong><span class="muted">{f.text}</span></div>
        </div>
      ))}
    </section>

    <section class="features wrap" aria-label="Features">
      {features.map((f, i) => (
        <article class:list={["feature", { flip: i % 2 === 1 }]}>
          <div class="feature-text reveal">
            <span class="kicker"><span class="icon-box"><Icon path={f.icon} /></span>{f.kicker}</span>
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <ul>
              {f.points.map((p, j) => <li style={`--i: ${j}`}><Icon path={mdiCheck} />{p}</li>)}
            </ul>
            <a class="more" href={f.href}>Learn more <Icon path={mdiArrowRight} /></a>
          </div>
          <div class="feature-shot card reveal" style="--d: 120ms">
            <Image src={f.image} alt={f.alt} widths={[560, 1028, 2056]} sizes="(max-width: 860px) 100vw, 560px" />
          </div>
        </article>
      ))}
    </section>

    <section class="wrap extras" aria-label="More features">
      <h2 class="reveal">And there's more</h2>
      <div class="more-grid">
        {more.map((m, i) => (
          <a class="more-card card reveal" href={m.href} style={`--d: ${i * 70}ms`}>
            <span class="icon-box"><Icon path={m.icon} /></span>
            <strong>{m.title}</strong>
            <span class="muted">{m.text}</span>
            <span class="go">Learn more <Icon path={mdiArrowRight} /></span>
          </a>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="wrap band-inner">
        <div class="band-text reveal">
          <span class="kicker"><span class="icon-box"><Icon path={mdiCellphone} /></span>On your phone</span>
          <h2>Made for the phone in your hand</h2>
          <p>In the Home Assistant app the panel gets a bottom tab bar and sheets that slide up, so boosting the heating on the way home is two taps. It follows your Home Assistant theme, light or dark.</p>
        </div>
        <Image class="reveal" style="--d: 120ms" src={phones} alt="Three phone screens: the heating schedule, a room's target and valves, and the boost sheet." widths={[700, 1400, 2800]} sizes="(max-width: 1120px) 100vw, 1088px" />
      </div>
    </section>

    <section class="wrap faq" aria-label="Questions">
      <h2 class="reveal">Questions</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="card reveal" style={`--d: ${i * 60}ms`}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="wrap start" aria-labelledby="start">
      <div class="start-card card reveal">
        <h2 id="start">Get started</h2>
        <p class="muted">Three steps from installing to your own schedule.</p>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="reveal" style={`--d: ${120 + i * 90}ms`}>
              <span class="num">{i + 1}</span>
              <strong>{s.title}</strong>
              <span class="muted">{s.text}</span>
            </li>
          ))}
        </ol>
        <div class="cta">
          <a class="btn primary" href={MARKETPLACE}>Add to Home Assistant <Icon path={mdiArrowRight} /></a>
          <a class="btn" href="/docs/installation/">Installation guide</a>
          <a class="btn" href={REPO}><Icon path={mdiGithub} /> GitHub</a>
        </div>
        <div class="works">
          <span class="muted">Works with</span>
          {hardware.map((h) => <span class="chip">{h}</span>)}
          <a class="more" href="/docs/hardware/">Supported hardware <Icon path={mdiArrowRight} /></a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { text-align: center; padding-top: 72px; display: flex; flex-direction: column; align-items: center; }
  .hero .pill :global(.icon) { width: 16px; height: 16px; }
  h1 { font-size: clamp(38px, 6.4vw, 68px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 750; margin: 20px 0 0; max-width: 17ch; text-wrap: balance; }
  .lede { font-size: clamp(17px, 2.1vw, 20px); color: var(--muted); max-width: 60ch; margin: 20px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 28px; }
  .cta.left { justify-content: flex-start; }
  .hero-shot { margin-top: 48px; width: 100%; border-radius: 24px; overflow: hidden; border: 1px solid var(--divider); background: var(--soft); }

  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 40px; }
  .fact { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: var(--radius); border: 1px solid var(--divider); background: var(--surface); }
  .fact div { display: grid; gap: 2px; font-size: 14px; line-height: 1.45; }
  .fact strong { font-size: 15px; }
  @media (max-width: 900px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; } }

  h2 { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; margin: 12px 0 0; }
  .kicker { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 650; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .kicker .icon-box { width: 34px; height: 34px; }
  .kicker .icon-box :global(.icon) { width: 19px; height: 19px; }

  .features { display: grid; gap: 96px; margin-top: 112px; }
  .feature { display: grid; grid-template-columns: 1fr 1.15fr; gap: 56px; align-items: center; }
  .feature.flip .feature-text { order: 2; }
  .feature-text p { color: var(--muted); font-size: 17px; margin: 14px 0 0; }
  .feature ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .feature li { display: flex; gap: 10px; align-items: flex-start; }
  .feature li :global(.icon) { color: var(--brand); margin-top: 3px; }
  .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 22px; font-weight: 650; text-decoration: none; color: var(--brand-strong); }
  .more:hover { text-decoration: underline; }
  .more :global(.icon) { width: 18px; height: 18px; }
  .feature-shot { overflow: hidden; background: var(--soft); }
  @media (max-width: 860px) {
    .features { gap: 64px; margin-top: 80px; }
    .feature { grid-template-columns: 1fr; gap: 24px; }
    .feature.flip .feature-text { order: 0; }
  }

  .band { margin-top: 112px; padding: 72px 0; background: var(--surface); border-block: 1px solid var(--divider); }
  .band-inner { display: grid; gap: 36px; }
  .band-text { max-width: 640px; }
  .band-text p { color: var(--muted); font-size: 17px; margin: 14px 0 0; }
  .band img { border-radius: 20px; }


  .faq { margin-top: 112px; max-width: 820px; }
  .faq-list { display: grid; gap: 10px; margin-top: 24px; }
  details { padding: 0 20px; }
  summary { cursor: pointer; list-style: none; padding: 18px 0; font-weight: 650; font-size: 17px; display: flex; justify-content: space-between; gap: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--muted); font-weight: 400; font-size: 22px; line-height: 1; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 18px; color: var(--muted); }


  /* Motion (see global.css): a soft glow breathing behind the hero, ticks that land one
     after another, screenshots that lean in on hover, and answers that slide open. */
  .hero-shot { position: relative; isolation: isolate; }
  .hero::after {
    content: ""; position: absolute; z-index: -1; left: 50%; top: 420px; width: min(900px, 90vw); height: 520px;
    transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--brand) 22%, transparent), transparent);
    filter: blur(40px); animation: glow 7s ease-in-out infinite alternate; pointer-events: none;
  }
  .hero { position: relative; }
  @keyframes glow { from { opacity: 0.55; transform: translateX(-50%) scale(0.94); } to { opacity: 1; transform: translateX(-50%) scale(1.04); } }
  .feature-text.reveal li { opacity: 1; }
  :global(.js) .feature-text.reveal li { opacity: 0; transform: translateX(-10px); transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); transition-delay: calc(250ms + var(--i) * 110ms); }
  :global(.js) .feature-text.reveal.in li { opacity: 1; transform: none; }
  .feature li :global(.icon) { transition: transform 0.4s var(--ease); transition-delay: calc(300ms + var(--i) * 110ms); }
  :global(.js) .feature-text.reveal li :global(.icon) { transform: scale(0.4); }
  :global(.js) .feature-text.reveal.in li :global(.icon) { transform: none; }
  .feature-shot :global(img) { transition: transform 0.6s var(--ease); }
  .feature-shot:hover :global(img) { transform: scale(1.025); }
  .fact { transition: border-color 0.2s, background 0.2s; }
  .fact:hover { border-color: color-mix(in srgb, var(--brand) 35%, var(--divider)); }
  .fact .icon-box { transition: background 0.25s, color 0.25s; }
  .fact:hover .icon-box { background: var(--brand-tint); color: var(--brand-strong); }
  summary::after { transition: transform 0.3s var(--ease); }
  details { interpolate-size: allow-keywords; }
  details::details-content { height: 0; overflow: clip; transition: height 0.35s var(--ease), content-visibility 0.35s allow-discrete; }
  details[open]::details-content { height: auto; }
  @media (prefers-reduced-motion: reduce) {
    .hero::after { animation: none; }
    :global(.js) .feature-text.reveal li, :global(.js) .feature-text.reveal li :global(.icon) { opacity: 1; transform: none; transition: none; }
    .feature-shot :global(img), details::details-content { transition: none; }
    .feature-shot:hover :global(img) { transform: none; }
  }

  /* And there's more: four compact cards, two by two on tablets, one column on phones. */
  .extras { margin-top: 112px; }
  .more-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 24px; }
  .more-card { display: flex; flex-direction: column; gap: 8px; padding: 20px; text-decoration: none; transition: border-color 0.2s, background 0.2s; }
  .more-card .icon-box { margin-bottom: 6px; transition: background 0.25s, color 0.25s; }
  .more-card strong { font-size: 17px; }
  .more-card .muted { font-size: 14.5px; line-height: 1.5; flex: 1; }
  .more-card .go { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; font-size: 14px; font-weight: 650; color: var(--brand-strong); }
  .more-card .go :global(.icon) { width: 16px; height: 16px; transition: transform 0.2s var(--ease); }
  .more-card:hover { border-color: color-mix(in srgb, var(--brand) 35%, var(--divider)); }
  .more-card:hover .icon-box { background: var(--brand-tint); color: var(--brand-strong); }
  .more-card:hover .go :global(.icon) { transform: translateX(3px); }
  @media (max-width: 960px) { .more-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .more-grid { grid-template-columns: 1fr; } }

  /* Get started: one centred card, steps side by side, then the hardware it works with. */
  .start { margin-top: 112px; }
  .start-card { padding: 48px 40px; text-align: center; background: radial-gradient(120% 90% at 50% 0%, var(--brand-tint), transparent 70%), var(--surface); }
  .start-card > p { margin: 10px 0 0; font-size: 17px; }
  .steps { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; counter-reset: none; }
  .steps li { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .steps .num { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 6px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 750; font-size: 17px; }
  .steps strong { font-size: 17px; }
  .steps .muted { font-size: 14.5px; line-height: 1.5; max-width: 30ch; }
  .start .cta { margin-top: 36px; }
  .works { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--divider); font-size: 14px; }
  .works > .muted { margin-right: 4px; font-weight: 600; }
  .chip { padding: 5px 12px; border-radius: 999px; background: var(--soft); font-weight: 550; }
  .works .more { margin: 0 0 0 4px; font-size: 14px; }
  @media (max-width: 760px) {
    .start-card { padding: 32px 20px; }
    .steps { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
