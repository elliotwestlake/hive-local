---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { MARKETPLACE, REPO } from "../lib/nav";
import {
  mdiArrowRight, mdiCalendarClock, mdiCash, mdiCellphone, mdiCheck, mdiCloudOffOutline,
  mdiFire, mdiHomeThermometer, mdiRadiator, mdiShieldCheckOutline, mdiSourceBranch,
  mdiBagSuitcaseOutline, mdiThermometerChevronUp, mdiZigbee, mdiChartBar, mdiWaterBoiler,
} from "@mdi/js";

import hero from "../assets/screenshots/hero.png";
import heating from "../assets/screenshots/heating.png";
import schedule from "../assets/screenshots/schedule.png";
import rooms from "../assets/screenshots/rooms.png";
import statsCost from "../assets/screenshots/stats-cost.png";
import holiday from "../assets/screenshots/holiday.png";
import devices from "../assets/screenshots/devices.png";
import phones from "../assets/screenshots/phones.png";
import dark from "../assets/screenshots/overview-dark.png";

const facts = [
  { icon: mdiCloudOffOutline, title: "No Hive cloud or hub", text: "Everything runs over your own Zigbee network." },
  { icon: mdiShieldCheckOutline, title: "Keeps running without HA", text: "Schedules live on the receiver itself." },
  { icon: mdiZigbee, title: "Zigbee2MQTT or ZHA", text: "Use whichever your Home Assistant has." },
  { icon: mdiSourceBranch, title: "Free and open source", text: "No account, no subscription, no tracking." },
];

const features = [
  {
    icon: mdiFire, kicker: "Heating and hot water",
    title: "Everything the thermostat does, in Home Assistant",
    text: "Turn the target up or down, switch between Schedule, Manual and Off, or boost for half an hour. A Hive sidebar panel puts it all in one place, and the same controls are entities for your automations.",
    points: ["Boost with your own default time and temperature", "Climate and water heater entities, plus actions", "Matches Hive Local Thermostat, so moving over is easy"],
    image: heating, alt: "The heating page: target, Schedule, Manual and Off, and pre-heat.", href: "/docs/the-hive-panel/",
  },
  {
    icon: mdiCalendarClock, kicker: "Schedules",
    title: "Edit the schedule on the receiver itself",
    text: "Read the week from the receiver, change a day, copy it to the weekdays, and save. Only the days you changed are written, and because the schedule lives on the receiver it keeps running even when Home Assistant is down.",
    points: ["Up to six times a day, like the Hive app", "Copy a day to weekdays, the weekend or every day", "Undo anything before you save"],
    image: schedule, alt: "A day's schedule, with each time's temperature.", href: "/docs/schedules/",
  },
  {
    icon: mdiRadiator, kicker: "Rooms",
    title: "Rooms of Hive radiator valves",
    text: "Group your Hive radiator valves into rooms, set one target for the room, and see each valve's temperature and battery. Hive Local can suggest rooms from your Home Assistant areas.",
    points: ["One target for every valve in a room", "A room sensor, or the valves' own readings", "Low batteries and unresponsive valves flagged"],
    image: rooms, alt: "A room with its temperature, target and radiator valves.", href: "/docs/rooms/",
  },
  {
    icon: mdiChartBar, kicker: "Stats",
    title: "See how long the boiler ran, and what it cost",
    text: "Day, week and month views of boiler time, compared with the period before and the temperature outside. Link your gas meter and Hive Local learns what your boiler really uses, for an honest cost estimate.",
    points: ["Learns your boiler's real output from the gas meter", "Uses your Energy dashboard's gas price, or your own", "Outside temperature from any weather entity"],
    image: statsCost, alt: "A week of boiler time with its estimated cost.", href: "/docs/stats/",
  },
  {
    icon: mdiThermometerChevronUp, kicker: "Pre-heat",
    title: "Warm by the time the schedule says",
    text: "Pre-heat learns how fast your home warms up from its own history and starts the heating early, so it's 20° at 07:00 rather than starting to warm up then. It uses a self-ending boost, so it can't leave the heating on.",
    points: ["Learns from 14 days of your own history", "Only starts as early as you allow", "Stops if you change your mind"],
    image: heating, alt: "The pre-heat card on the heating page.", href: "/docs/pre-heat/", hidden: true,
  },
  {
    icon: mdiBagSuitcaseOutline, kicker: "Away",
    title: "Going away? Say when you're back",
    text: "Holiday mode holds the heating at frost protection and turns the hot water off until the date you choose, then puts everything back the way it was. If Home Assistant goes down while you're away, the receiver ends the hold by itself within six hours.",
    points: ["Back to your previous modes at the end", "Fails safe if Home Assistant stops", "One action for every receiver"],
    image: holiday, alt: "The Away sheet: back on a date, heating held at 12°.", href: "/docs/holiday/",
  },
  {
    icon: mdiHomeThermometer, kicker: "Devices",
    title: "Your receivers and valves at a glance",
    text: "See every Hive receiver and radiator valve, whether it's online, its room and its battery. If ZHA's \"receiver goes red\" problem affects you, Hive Local fixes the thermostat's reporting for you.",
    points: ["Online status and batteries", "Fixes ZHA's “No signal” thermostat problem", "Diagnostics to attach to bug reports"],
    image: devices, alt: "The Devices tab: the receiver and every radiator valve, with batteries.", href: "/docs/troubleshooting/",
  },
].filter((f) => !f.hidden);

const hardware = [
  { model: "SLR1, SLR1b, SLR1c, SLR1d", what: "Heating" },
  { model: "OTR1 (OpenTherm)", what: "Heating" },
  { model: "SLR2, SLR2b, SLR2c, SLR2d", what: "Heating and hot water" },
  { model: "Hive radiator valve (UK7004240)", what: "Rooms" },
  { model: "Hive thermostats (SLT)", what: "Keep working alongside" },
];

const faqs = [
  {
    q: "Do I still need the Hive hub or app?",
    a: "No. The receiver is paired to your own Zigbee network (Zigbee2MQTT or ZHA) instead of the Hive hub, and Hive Local controls it from there. The Hive app can't see a receiver that isn't on the Hive hub.",
  },
  {
    q: "What happens if Home Assistant goes down?",
    a: "Your heating carries on. The schedule is stored on the receiver, and the wall thermostat still works. Boosts, pre-heats and holidays all use the receiver's own self-ending boost, so nothing is left on.",
  },
  {
    q: "How is this different from Hive Local Thermostat?",
    a: "Both control Hive receivers locally. Hive Local's boost, cancel and mode entities and actions were designed to match Hive Local Thermostat's, so moving across feels familiar, and it adds the Hive panel, schedules, rooms, stats, pre-heat and holiday mode.",
  },
  {
    q: "Is it safe to write schedules?",
    a: "Hive Local writes a whole day at a time, only the days you change, and pads each one to the receiver's six slots so nothing old is left behind. It's still early software, so read your schedule first and check the change on the thermostat.",
  },
];
---
<Base title="Hive Local" description="Local control of Hive heating and hot water from Home Assistant, with no Hive cloud and no Hive hub. Schedules, boost, rooms, stats and holiday mode.">
  <main>
    <section class="hero wrap">
      <span class="pill"><Icon path={mdiZigbee} /> For Home Assistant, on Zigbee2MQTT or ZHA</span>
      <h1>Your Hive heating, without the cloud.</h1>
      <p class="lede">Hive Local runs your Hive receiver straight from Home Assistant over Zigbee. Change the schedule, boost the heating and see what the boiler's doing, with no hub, no account and nothing in the cloud.</p>
      <div class="cta">
        <a class="btn primary" href={MARKETPLACE}>Add to Home Assistant <Icon path={mdiArrowRight} /></a>
        <a class="btn" href="/docs/">Read the docs</a>
      </div>
      <div class="hero-shot">
        <Image src={hero} alt="The Hive panel on a desktop and a phone: heating following its schedule, and hot water on a boost." widths={[700, 1400, 2100, 2800]} sizes="(max-width: 1120px) 100vw, 1088px" loading="eager" />
      </div>
    </section>

    <section class="facts wrap" aria-label="At a glance">
      {facts.map((f) => (
        <div class="fact">
          <span class="icon-box"><Icon path={f.icon} /></span>
          <div><strong>{f.title}</strong><span class="muted">{f.text}</span></div>
        </div>
      ))}
    </section>

    <section class="features wrap" aria-label="Features">
      {features.map((f, i) => (
        <article class:list={["feature", { flip: i % 2 === 1 }]}>
          <div class="feature-text">
            <span class="kicker"><span class="icon-box"><Icon path={f.icon} /></span>{f.kicker}</span>
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <ul>
              {f.points.map((p) => <li><Icon path={mdiCheck} />{p}</li>)}
            </ul>
            <a class="more" href={f.href}>Learn more <Icon path={mdiArrowRight} /></a>
          </div>
          <div class="feature-shot card">
            <Image src={f.image} alt={f.alt} widths={[560, 1028, 2056]} sizes="(max-width: 860px) 100vw, 560px" />
          </div>
        </article>
      ))}
    </section>

    <section class="band">
      <div class="wrap band-inner">
        <div class="band-text">
          <span class="kicker"><span class="icon-box"><Icon path={mdiCellphone} /></span>On your phone</span>
          <h2>Made for the phone in your hand</h2>
          <p>In the Home Assistant app the panel gets a bottom tab bar and sheets that slide up, so boosting the heating on the way home is two taps. It follows your Home Assistant theme, light or dark.</p>
        </div>
        <Image src={phones} alt="Three phone screens: the heating schedule, a room's target and valves, and the boost sheet." widths={[700, 1400, 2800]} sizes="(max-width: 1120px) 100vw, 1088px" />
      </div>
    </section>

    <section class="wrap split">
      <div>
        <span class="kicker"><span class="icon-box"><Icon path={mdiWaterBoiler} /></span>Hardware</span>
        <h2>Works with Hive receivers</h2>
        <p class="muted">Pair the receiver to Zigbee2MQTT or ZHA, then add it to Hive Local. Heating and hot water are set up from the model.</p>
        <div class="card table">
          {hardware.map((h) => (
            <div class="row"><span>{h.model}</span><span class="muted">{h.what}</span></div>
          ))}
        </div>
      </div>
      <div>
        <span class="kicker"><span class="icon-box"><Icon path={mdiCash} /></span>Install</span>
        <h2>Set up in three steps</h2>
        <ol class="steps">
          <li><strong>Install from the Marketplace</strong><span class="muted">Add Hive Local in the Marketplace (formerly HACS) and restart Home Assistant.</span></li>
          <li><strong>Add your receiver</strong><span class="muted">Choose Zigbee2MQTT or ZHA, then pick the receiver (not the wall thermostat).</span></li>
          <li><strong>Open Hive in the sidebar</strong><span class="muted">Read your schedule from the receiver before changing it.</span></li>
        </ol>
        <div class="cta left">
          <a class="btn primary" href={MARKETPLACE}>Add to Home Assistant</a>
          <a class="btn" href="/docs/installation/">Full steps</a>
        </div>
      </div>
    </section>

    <section class="wrap faq" aria-label="Questions">
      <h2>Questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="card">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="wrap closing">
      <div class="card closing-card">
        <div>
          <h2>Take your heating local</h2>
          <p class="muted">Free, open source and built by someone who runs it on their own Hive setup.</p>
          <div class="cta left">
            <a class="btn primary" href={MARKETPLACE}>Add to Home Assistant <Icon path={mdiArrowRight} /></a>
            <a class="btn" href={REPO}>View on GitHub</a>
          </div>
        </div>
        <Image src={dark} alt="The Overview in a dark theme." widths={[480, 960]} sizes="(max-width: 860px) 100vw, 420px" />
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { text-align: center; padding-top: 72px; display: flex; flex-direction: column; align-items: center; }
  .hero .pill .icon { width: 16px; height: 16px; }
  h1 { font-size: clamp(38px, 6.4vw, 68px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 750; margin: 20px 0 0; max-width: 17ch; text-wrap: balance; }
  .lede { font-size: clamp(17px, 2.1vw, 20px); color: var(--muted); max-width: 60ch; margin: 20px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 28px; }
  .cta.left { justify-content: flex-start; }
  .hero-shot { margin-top: 48px; width: 100%; border-radius: 24px; overflow: hidden; border: 1px solid var(--divider); background: var(--soft); }

  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 40px; }
  .fact { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: var(--radius); border: 1px solid var(--divider); background: var(--surface); }
  .fact div { display: grid; gap: 2px; font-size: 14px; line-height: 1.45; }
  .fact strong { font-size: 15px; }
  @media (max-width: 900px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; } }

  h2 { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; margin: 12px 0 0; }
  .kicker { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 650; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .kicker .icon-box { width: 34px; height: 34px; }
  .kicker .icon-box .icon { width: 19px; height: 19px; }

  .features { display: grid; gap: 96px; margin-top: 112px; }
  .feature { display: grid; grid-template-columns: 1fr 1.15fr; gap: 56px; align-items: center; }
  .feature.flip .feature-text { order: 2; }
  .feature-text p { color: var(--muted); font-size: 17px; margin: 14px 0 0; }
  .feature ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .feature li { display: flex; gap: 10px; align-items: flex-start; }
  .feature li .icon { color: var(--brand); margin-top: 3px; }
  .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 22px; font-weight: 650; text-decoration: none; color: var(--brand-strong); }
  .more:hover { text-decoration: underline; }
  .more .icon { width: 18px; height: 18px; }
  .feature-shot { overflow: hidden; background: var(--soft); }
  @media (max-width: 860px) {
    .features { gap: 64px; margin-top: 80px; }
    .feature { grid-template-columns: 1fr; gap: 24px; }
    .feature.flip .feature-text { order: 0; }
  }

  .band { margin-top: 112px; padding: 72px 0; background: var(--surface); border-block: 1px solid var(--divider); }
  .band-inner { display: grid; gap: 36px; }
  .band-text { max-width: 640px; }
  .band-text p { color: var(--muted); font-size: 17px; margin: 14px 0 0; }
  .band img { border-radius: 20px; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; margin-top: 112px; }
  .split > div > p { margin: 12px 0 0; }
  .table { margin-top: 20px; overflow: hidden; }
  .row { display: flex; justify-content: space-between; gap: 16px; padding: 14px 18px; font-size: 15px; }
  .row + .row { border-top: 1px solid var(--divider); }
  .row span:last-child { text-align: right; }
  .steps { list-style: none; counter-reset: step; padding: 0; margin: 20px 0 0; display: grid; gap: 12px; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 36px 1fr; column-gap: 14px; padding: 14px 16px; border: 1px solid var(--divider); border-radius: var(--radius); background: var(--surface); }
  .steps li::before { content: counter(step); grid-row: span 2; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--brand-tint); color: var(--brand-strong); font-weight: 700; }
  .steps span { font-size: 14px; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; gap: 56px; margin-top: 80px; } }

  .faq { margin-top: 112px; max-width: 820px; }
  .faq-list { display: grid; gap: 10px; margin-top: 24px; }
  details { padding: 0 20px; }
  summary { cursor: pointer; list-style: none; padding: 18px 0; font-weight: 650; font-size: 17px; display: flex; justify-content: space-between; gap: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--muted); font-weight: 400; font-size: 22px; line-height: 1; }
  details[open] summary::after { content: "−"; }
  details p { margin: 0 0 18px; color: var(--muted); }

  .closing { margin-top: 112px; }
  .closing-card { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; padding: 40px; overflow: hidden; background: linear-gradient(135deg, var(--brand-tint), transparent 60%), var(--surface); }
  .closing-card p { margin: 12px 0 0; font-size: 17px; }
  .closing-card img { border-radius: 14px; border: 1px solid var(--divider); }
  @media (max-width: 860px) { .closing-card { grid-template-columns: 1fr; padding: 24px; } }
</style>
